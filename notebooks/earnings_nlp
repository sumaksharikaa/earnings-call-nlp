   "source": [
    "import re\n",
    "\n",
    "def extract_qa_section(transcript):\n",
    "    \"\"\"Extract just the Q&A section from earnings call.\"\"\"\n",
    "    patterns = ['Questions & Answers', 'Q&A', 'QUESTION AND ANSWER', 'Questions and Answers']\n",
    "    for pattern in patterns:\n",
    "        if pattern in transcript:\n",
    "            return transcript.split(pattern)[-1][:3000]\n",
    "    return transcript[:3000]\n",
    "\n",
    "def get_sentiment(text):\n",
    "    \"\"\"Run FinBERT on text chunk, return scores.\"\"\"\n",
    "    text = re.sub(r'\\s+', ' ', text).strip()\n",
    "    text = text[:512]\n",
    "    try:\n",
    "        result = finbert(text)[0]\n",
    "        scores = {item['label']: item['score'] for item in result}\n",
    "        return scores.get('positive', 0), scores.get('negative', 0), scores.get('neutral', 0)\n",
    "    except:\n",
    "        return 0, 0, 1\n",
    "\n",
    "# Test on one transcript\n",
    "sample = df[df['ticker'] == 'AAPL'].iloc[0]\n",
    "pos, neg, neu = get_sentiment(extract_qa_section(sample['transcript']))\n",
    "print(f\"Apple earnings call sentiment:\")\n",
    "print(f\"  Positive: {pos:.3f}\")\n",
    "print(f\"  Negative: {neg:.3f}\")\n",
    "print(f\"  Neutral:  {neu:.3f}\")"
   ]
