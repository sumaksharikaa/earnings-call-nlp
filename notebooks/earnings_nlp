    "from tqdm import tqdm\n",
    "tqdm.pandas()\n",
    "\n",
    "# Focus on major US companies across sectors\n",
    "target_tickers = [\n",
    "    'AAPL', 'MSFT', 'GOOGL', 'AMZN', 'META',  # Tech\n",
    "    'JPM', 'BAC', 'WFC', 'GS', 'BLK',           # Finance\n",
    "    'JNJ', 'PFE', 'MRNA', 'ABT',                 # Healthcare\n",
    "    'WMT', 'TGT', 'AMZN', 'COST',               # Retail\n",
    "    'XOM', 'CVX',                                 # Energy\n",
    "    'TSLA', 'F', 'GM',                            # Autos\n",
    "    'DIS', 'NFLX',                                # Media\n",
    "    'KO', 'PEP', 'MCD',                          # Consumer\n",
    "    'INTC', 'NVDA', 'AMD',                        # Semiconductors\n",
    "]\n",
    "\n",
    "df_target = df[df['ticker'].isin(target_tickers)].copy()\n",
    "print(f\"Analyzing {len(df_target):,} transcripts for {df_target['ticker'].nunique()} companies...\")\n",
    "\n",
    "results = []\n",
    "for _, row in tqdm(df_target.iterrows(), total=len(df_target)):\n",
    "    pos, neg, neu = get_sentiment(extract_qa_section(row['transcript']))\n",
    "    results.append({\n",
    "        'ticker': row['ticker'],\n",
    "        'quarter': row['q'],\n",
    "        'date': row['date'],\n",
    "        'positive': pos,\n",
    "        'negative': neg,\n",
    "        'neutral': neu,\n",
    "        'sentiment_score': pos - neg\n",
    "    })\n",
    "\n",
    "df_sentiment = pd.DataFrame(results)\n",
    "print(f\"\\nDone! Analyzed {len(df_sentiment):,} transcripts\")\n",
    "df_sentiment.head(10)"
   ]
  },
