    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "sns.set_theme(style='whitegrid')\n",
    "fig, axes = plt.subplots(2, 2, figsize=(16, 12))\n",
    "\n",
    "# 1. Average sentiment score by company\n",
    "company_sentiment = df_sentiment.groupby('ticker')['sentiment_score'].mean().sort_values(ascending=False)\n",
    "axes[0,0].barh(company_sentiment.index, company_sentiment.values,\n",
    "               color=['green' if x > 0 else 'red' for x in company_sentiment.values])\n",
    "axes[0,0].set_title('Average Sentiment Score by Company', fontweight='bold')\n",
    "axes[0,0].set_xlabel('Sentiment Score (Positive - Negative)')\n",
    "axes[0,0].axvline(0, color='black', linewidth=0.8)\n",
    "\n",
    "# 2. Sentiment by sector\n",
    "sector_map = {\n",
    "    'AAPL':'Tech','MSFT':'Tech','GOOGL':'Tech','AMZN':'Tech','META':'Tech',\n",
    "    'INTC':'Tech','NVDA':'Tech','AMD':'Tech',\n",
    "    'JPM':'Finance','BAC':'Finance','WFC':'Finance','GS':'Finance','BLK':'Finance',\n",
    "    'JNJ':'Healthcare','PFE':'Healthcare','MRNA':'Healthcare','ABT':'Healthcare',\n",
    "    'WMT':'Retail','TGT':'Retail','COST':'Retail',\n",
    "    'XOM':'Energy','CVX':'Energy',\n",
    "    'TSLA':'Auto','F':'Auto','GM':'Auto',\n",
    "    'DIS':'Media','NFLX':'Media',\n",
    "    'KO':'Consumer','PEP':'Consumer','MCD':'Consumer'\n",
    "}\n",
    "df_sentiment['sector'] = df_sentiment['ticker'].map(sector_map)\n",
    "sector_sentiment = df_sentiment.groupby('sector')['sentiment_score'].mean().sort_values(ascending=False)\n",
    "axes[0,1].bar(sector_sentiment.index, sector_sentiment.values,\n",
    "              color=sns.color_palette('RdYlGn', len(sector_sentiment)))\n",
    "axes[0,1].set_title('Average Sentiment by Sector', fontweight='bold')\n",
    "axes[0,1].set_ylabel('Sentiment Score')\n",
    "axes[0,1].tick_params(axis='x', rotation=45)\n",
