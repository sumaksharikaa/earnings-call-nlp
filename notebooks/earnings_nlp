    "\n",
    "positive_keywords = [\n",
    "    'growth', 'exceed', 'record', 'strong', 'momentum',\n",
    "    'opportunity', 'expand', 'innovation', 'outperform',\n",
    "    'confident', 'optimistic', 'beat', 'milestone', 'accelerat'\n",
    "]\n",
    "\n",
    "def count_keywords(text, keywords):\n",
    "    text_lower = text.lower()\n",
    "    return sum(text_lower.count(kw) for kw in keywords)\n",
    "\n",
    "df_target2 = df[df['ticker'].isin(target_tickers)].copy()\n",
    "df_target2['risk_count']     = df_target2['transcript'].apply(\n",
    "    lambda x: count_keywords(x, risk_keywords))\n",
    "df_target2['positive_count'] = df_target2['transcript'].apply(\n",
    "    lambda x: count_keywords(x, positive_keywords))\n",
    "df_target2['risk_ratio']     = df_target2['risk_count'] / (\n",
    "    df_target2['risk_count'] + df_target2['positive_count'] + 1)\n",
    "\n",
    "# Merge with sentiment\n",
    "df_full = df_sentiment.merge(\n",
    "    df_target2[['ticker','q','risk_count','positive_count','risk_ratio']],\n",
    "    left_on=['ticker','quarter'], right_on=['ticker','q'], how='left'\n",
    ")\n",
    "\n",
    "# Plot risk ratio by company\n",
    "fig, axes = plt.subplots(1, 2, figsize=(16, 6))\n",
    "\n",
    "risk_by_company = df_full.groupby('ticker')['risk_ratio'].mean().sort_values(ascending=False)\n",
    "axes[0].barh(risk_by_company.index, risk_by_company.values,\n",
    "             color=sns.color_palette('Reds_r', len(risk_by_company)))\n",
    "axes[0].set_title('Risk Language Ratio by Company', fontweight='bold')\n",
    "axes[0].set_xlabel('Risk Ratio (higher = more risk language)')\n",
    "\n",
    "# Sentiment score vs risk ratio scatter\n",
    "axes[1].scatter(df_full['risk_ratio'], df_full['sentiment_score'],\n",
    "                alpha=0.6, c=df_full['sentiment_score'], cmap='RdYlGn', s=50)\n",
    "for ticker in ['TSLA','DIS','MRNA','AAPL','WFC']:\n",
    "    subset = df_full[df_full['ticker']==ticker]\n",
    "    if len(subset) > 0:\n",
    "        axes[1].annotate(ticker,\n",
    "            (subset['risk_ratio'].mean(), subset['sentiment_score'].mean()),\n",
    "            fontsize=8)\n",
    "axes[1].set_title('Sentiment Score vs Risk Language', fontweight='bold')\n",
    "axes[1].set_xlabel('Risk Ratio')\n",
    "axes[1].set_ylabel('Sentiment Score')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('../notebooks/risk_keywords.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "print(\"Risk analysis done!\")\n",
    "print(f\"\\nTop 5 highest risk language companies:\")\n",
    "print(risk_by_company.head())\n",
    "print(f\"\\nTop 5 most positive language companies:\")\n",
    "print(df_full.groupby('ticker')['risk_ratio'].mean().sort_values().head())"
   ]
